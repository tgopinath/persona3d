# ── Persona3D configuration ─────────────────────────────────────────────
# Copy to .env.local. Everything is optional: with nothing set the app runs in
# local mode (single user, files in .data/) with the Demo provider.

# Supabase (auth + Postgres + private storage). Leave empty for local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=persona3d-private
# Show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_GOOGLE_AUTH=false

# AI providers (server only). The first configured one becomes the default.
MESHY_API_KEY=
TRIPO_API_KEY=
# Force a default provider id: demo | meshy | tripo
PERSONA3D_PROVIDER=

# Limits and behaviour
PERSONA3D_MAX_UPLOAD_MB=15
PERSONA3D_RATE_LIMIT_PER_MIN=30
PERSONA3D_RETENTION_DAYS=30
# Pause between demo stages so progress is visible (0 to disable). Demo only.
PERSONA3D_DEMO_STAGE_DELAY_MS=700
# Signs local-storage download links. Set a long random value outside dev.
PERSONA3D_SIGNING_SECRET=
# false when a separate `npm run worker` process handles jobs.
PERSONA3D_IN_PROCESS_WORKER=true
